# Required in production. Omit only for local bundled-demo development.
DATABASE_URL=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Must point to a separate database whose name contains "test".
INTEGRATION_DATABASE_URL=
# Both values are required in production.
SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=
# Optional release label exposed by health checks (letters, numbers, dot, dash, underscore).
APP_VERSION=
# Used only by npm run deploy:check; use an HTTPS origin outside localhost.
DEPLOYMENT_URL=

# Local preserves /uploads/... during development. Production must use s3.
MEDIA_STORAGE_DRIVER=local
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Optional comma-separated HTTP(S) origins for externally hosted tour media.
MEDIA_ALLOWED_ORIGINS=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=uploads

# Memory is for local development only. Production must use upstash.
RATE_LIMIT_DRIVER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PREFIX=vr360:rate-limit
# Enable only behind a proxy that overwrites client-supplied forwarding headers.
TRUST_PROXY_HEADERS=false

# Use a dedicated random secret of at least 32 characters. Required in production.
ANALYTICS_HASH_SECRET=
# Analytics events older than this many days are eligible for deletion (1-365).
ANALYTICS_RETENTION_DAYS=90
